<Window x:Class="LauncherSPT.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definições" Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="24">
        <TextBlock Text="CAMINHOS" Foreground="{StaticResource AccentOrange}"
                   FontFamily="Consolas" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

        <TextBlock Text="SPT.Server.exe" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ServerPathBox" Grid.Column="0" Height="30" Padding="6,4"
                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                     BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Procurar..." Style="{StaticResource TacticalButton}"
                    Margin="8,0,0,0" Click="BrowseServer_Click"/>
        </Grid>

        <TextBlock Text="EscapeFromTarkov.exe (opcional - detetado automaticamente na pasta do servidor)"
                   Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GamePathBox" Grid.Column="0" Height="30" Padding="6,4"
                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                     BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Procurar..." Style="{StaticResource TacticalButton}"
                    Margin="8,0,0,0" Click="BrowseGame_Click"/>
        </Grid>

        <TextBlock Text="Porta do servidor" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="PortBox" Height="30" Width="100" HorizontalAlignment="Left" Padding="6,4"
                 Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                 BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Imagem de fundo (opcional, .jpg / .png)" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BackgroundPathBox" Grid.Column="0" Height="30" Padding="6,4"
                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                     BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Procurar..." Style="{StaticResource TacticalButton}"
                    Margin="8,0,0,0" Click="BrowseBackground_Click"/>
        </Grid>

        <TextBlock Text="TEXTOS" Foreground="{StaticResource AccentOrange}"
                   FontFamily="Consolas" FontWeight="Bold" FontSize="14" Margin="0,4,0,14"/>

        <TextBlock Text="Linha de cima (pequena)" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleTopBox" Height="30" Padding="6,4"
                 Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                 BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Título principal (grande, laranja)" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleMainBox" Height="30" Padding="6,4"
                 Background="{StaticResource BgPanel}" Foreground="{StaticResource TextLight}"
                 BorderBrush="#2A2E20" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                 Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource TacticalButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Guardar" Style="{StaticResource PlayButton}" FontSize="13" Padding="20,10" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
