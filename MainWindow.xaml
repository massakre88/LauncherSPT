<Window x:Class="LauncherSPT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPT Launcher"
        Height="640" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Style x:Key="ProfileCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#3A3F2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>

                            <ContentPresenter Grid.Column="0"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               TextElement.Foreground="{StaticResource TextLight}"/>

                            <Path Grid.Column="1" Data="M0,0 L6,6 L12,0 Z" Fill="{StaticResource AccentOrange}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"
                                   Width="{TemplateBinding ActualWidth}">
                                <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource AccentOrangeDark}"
                                        BorderThickness="1" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource BgPanel}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{StaticResource TextLight}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Olive}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#4A5439"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo das abas principais -->
        <Style x:Key="MainTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{StaticResource BgPanel}" BorderBrush="#2A2E20" BorderThickness="1,1,1,0" Padding="22,10">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{StaticResource TextDim}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B1F14"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="#2A2E20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- Barra de topo -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="#2A2E20" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="S P T   L A U N C H E R" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="18,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="SettingsButton" Content="⚙" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextLight}" FontSize="16"
                            Cursor="Hand" Click="SettingsButton_Click"/>
                    <Button Content="—" Width="30" Height="30" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextLight}" FontSize="14"
                            Cursor="Hand" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Width="30" Height="30" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextLight}" FontSize="14"
                            Cursor="Hand" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corpo central com imagem de fundo + abas -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B0D0A" Offset="0"/>
                    <GradientStop Color="#141710" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"/>

            <Rectangle x:Name="BackgroundOverlay" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B00B0D0A" Offset="0"/>
                        <GradientStop Color="#DD0B0D0A" Offset="0.55"/>
                        <GradientStop Color="#F00B0D0A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TopTitleText" Text="ESCAPE FROM TARKOV" Foreground="{StaticResource TextDim}"
                           FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="MainTitleText" Text="SINGLE PLAYER" Foreground="{StaticResource AccentOrange}"
                           FontFamily="Consolas" FontSize="42" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,26"/>

                <TabControl x:Name="MainTabControl" Style="{StaticResource MainTabControl}" Width="560"
                            SelectionChanged="MainTabControl_SelectionChanged">

                    <!-- ==================== ABA JOGAR ==================== -->
                    <TabItem Header="JOGAR" Style="{StaticResource MainTabItem}">
                        <Border BorderBrush="#2A2E20" BorderThickness="1,0,1,1" Padding="24,18">
                            <Border.Background>
                                <SolidColorBrush Color="#14170F" Opacity="0.9"/>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="PERFIL" Foreground="{StaticResource TextDim}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProfileComboBox" Grid.Column="0" Style="{StaticResource ProfileCombo}"
                                              DisplayMemberPath="." Height="34"/>
                                    <Button Grid.Column="1" Content="⟳" Width="34" Height="34" Margin="6,0,0,0"
                                            Style="{StaticResource TacticalButton}" Padding="0"
                                            Click="RefreshProfilesButton_Click" ToolTip="Atualizar lista de perfis"/>
                                </Grid>

                                <TextBlock x:Name="StatusText" Text="A verificar configuração..."
                                           Foreground="{StaticResource TextLight}" FontFamily="Consolas" FontSize="13"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== ABA PERFIS ==================== -->
                    <TabItem Header="PERFIS" Style="{StaticResource MainTabItem}">
                        <Border BorderBrush="#2A2E20" BorderThickness="1,0,1,1" Padding="24,18">
                            <Border.Background>
                                <SolidColorBrush Color="#14170F" Opacity="0.9"/>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="PERFIS EXISTENTES" Foreground="{StaticResource AccentOrange}"
                                           FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                <Border BorderBrush="#2A2E20" BorderThickness="1" Background="{StaticResource BgPanel}"
                                        Height="130" Margin="0,0,0,14">
                                    <ListBox x:Name="ManageProfilesListBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextLight}" FontFamily="Consolas" FontSize="12">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextLight}"/>
                                                    <Button Grid.Column="1" Content="APAGAR" Style="{StaticResource TacticalButton}"
                                                            Padding="10,4" FontSize="11"
                                                            Tag="{Binding}" Click="DeleteProfile_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Text="CRIAR NOVO PERFIL" Foreground="{StaticResource AccentOrange}"
                                           FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Nome de utilizador" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NewUsernameBox" Style="{StaticResource FieldBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Edição" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="EditionComboBox" Style="{StaticResource ProfileCombo}" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="CreateProfileButton" Content="CRIAR PERFIL" Style="{StaticResource PlayButton}"
                                        FontSize="13" Padding="16,10" HorizontalAlignment="Left" Click="CreateProfile_Click"/>

                                <TextBlock x:Name="ProfilesStatusText" Foreground="{StaticResource TextDim}"
                                           FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </Grid>

        <!-- Rodapé com ações -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="#2A2E20" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StopButton" Content="PARAR SERVIDOR" Style="{StaticResource TacticalButton}"
                            Click="StopButton_Click" IsEnabled="False"/>
                </StackPanel>

                <Button x:Name="PlayButton" Content="JOGAR" Style="{StaticResource PlayButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="PlayButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
